NARRATIX_HOME=D:/prjs/n2oss/backend
GPT_API_KEY = 
GEMINI_API_KEY =
CLAUDE_API_KEY = 
CURSOR_API_KEY =
# cursor | gemini | gpt-5 | claude
SAGE_LLM_TYPE=gemini
# local (cursor-sdk, default) | cloud (REST no-repo agent)
SAGE_CURSOR_RUNTIME=local
SAGE_CURSOR_MODEL=composer-2.5
LOG_LEVEL = 
# LLM generate() 타임아웃(초) — release codegen 등 대용량 attach 시 120초 부족할 수 있음
# Cursor 사용 시 600 권장 (미설정 시 CursorLLM 기본 600)
SAGE_LLM_TIMEOUT_SEC=600
SAGE_CURSOR_TIMEOUT_SEC=600
# LLM attach 크기 제한 (bytes) — codegen 직전 검증
SAGE_LLM_ATTACH_MAX_BYTES=262144
SAGE_LLM_ATTACH_RELEASE_MAX_BYTES=524288
# LLM 비용 추정 (USD per 1M tokens) — 모델별 override: SAGE_LLM_PRICE_<MODEL>_INPUT_MT
SAGE_LLM_PRICE_INPUT_MT=1.0
SAGE_LLM_PRICE_OUTPUT_MT=3.0
# Kiwoom Open API (sage/data/kiwoom.py) — 소스에 토큰을 넣지 말 것
KIWOOM_ACCESS_TOKEN=
# REST API 인증 (디버깅/로컬 기본 off — API-Key 없이 UI·curl 동작)
# on | off — on 일 때만 SAGE_API_KEY 검사. 예: openssl rand -hex 32
SAGE_API_AUTH_ENABLED=off
SAGE_API_KEY=
# SecretKey DB 암·복호화 (KIS APPKEY 등) — SAGE_API_KEY(FE REST) 와 별도
# 미설정 시 sage-dev-change-me. exec worker 와 동일 값 유지 필요
SAGE_SECRET_ENCRYPTION_KEY=
# Exec isolation — docker_pool only (host /host/n2 bind mount)
SAGE_EXEC_DRIVER=docker_pool
SAGE_EXEC_TIMEOUT_SEC=600
SAGE_EXEC_STALL_SEC=45
SAGE_EXEC_POOL_ACQUIRE_SEC=120
SAGE_EXEC_MAX_JOBS_PER_CONTAINER=50
SAGE_EXEC_DOCKER_IMAGE=sage-exec:latest
# Docker worker → host MCP (python main.py 기동 후 8091)
SAGE_MCP_BASE_URL=http://host.docker.internal:8091
# MCP gateway bind (docker_pool 기본 0.0.0.0 — host.docker.internal 접근용)
# SAGE_MCP_BIND_HOST=0.0.0.0
# Compose project names (docker-compose.yml=name: n2-db, docker-compose.exec.yml=name: n2-exec)
# Admin JWT (layout-admin UI) — 운영 환경에서 반드시 변경
SAGE_ADMIN_JWT_SECRET=
SAGE_ADMIN_TOKEN_TTL_HOURS=12
