BREWSYNC_CLIENT_PORT=5000
BREWSYNC_API_URL="http://localhost:8090"
BREWSYNC_API_ENDPOINT="/api"
# SAGE.py REST/SSE API Key — 백엔드 SAGE_API_KEY 와 동일 (설정 시 /data /report /tool /secret 필수)
VITE_SAGE_API_KEY=
# dev: React Query Devtools 우측 하단 배너 — 시연 촬영 시 비우거나 false (표시하려면 true)
# VITE_ENABLE_RQ_DEVTOOLS=true